---
import { SplitsDemo } from "../app/islands/SplitsDemo";
import Section from "./Section.astro";
import SectionHead from "./SectionHead.astro";
---

<Section id="terminals" dark>
  <div class="wrap indent">
    <SectionHead
      sectionId="terminals"
      title="As many as it takes."
      text="Run an agent next to a shell, or many agents next to each other. The ones you can't see keep running."
    />
    <SplitsDemo client:visible />
  </div>
</Section>
