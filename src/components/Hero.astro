---
import { HeroApp } from "../app/islands/HeroApp";
---

<section class="hero">
  <div class="wrap">
    <div class="print">
      <picture class="knot">
        <source
          media="(max-width: 620px)"
          srcset="/hero-knot-narrow.webp"
          width="410"
          height="400"
        />
        <img
          src="/hero-knot-wide.webp"
          width="1360"
          height="640"
          alt=""
          decoding="async"
          fetchpriority="high"
        />
      </picture>
      <h1>
        Many agents.
        <br />
        One thread.
      </h1>
      <p class="lead">
        Run your coding agents side by side. You only hear from them when one needs you.
      </p>
    </div>
    <div class="window" data-thread-start>
      <HeroApp client:load />
    </div>
    <noscript>
      <p class="note">
        This window needs JavaScript. It shows agents working in tabs and terminals.
      </p>
    </noscript>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow-x: clip;
  }

  /*
    The plate hangs from the window's top edge and scales with the content's width. Sizes are
    plate measures over the width the plate was drawn for: its left margin keeps the thread on
    the window's left edge, and its overhang stays hidden behind the window.
  */
  .print {
    position: relative;
    container-type: inline-size;
  }

  .knot {
    position: absolute;
    bottom: calc(-132 / 1224 * 100cqw);
    left: calc(-20 / 1224 * 100cqw);
    width: calc(1360 / 1224 * 100cqw);
    pointer-events: none;
  }

  .knot img {
    display: block;
    width: 100%;
    height: auto;
  }

  h1 {
    position: relative;
    padding-top: 2.2cqw;
    color: var(--sumi);
    font-size: 9.5cqw;
    line-height: 0.98;
  }

  .lead {
    position: relative;
    max-width: 58cqw;
    margin-top: 1.3cqw;
    padding-bottom: calc(168 / 1224 * 100cqw);
  }

  .window {
    position: relative;
  }

  /* A gap cut around the window, the same one the knot leaves where a cord passes over. */
  .window::before {
    content: "";
    position: absolute;
    inset: -5px;
    border-radius: 15px;
    background: var(--paper) var(--grain);
  }

  .note {
    padding: 24px 0;
    color: var(--pencil);
  }

  @media (max-width: 620px) {
    .knot {
      bottom: calc(-106 / 358 * 100cqw);
      left: calc(-10 / 358 * 100cqw);
      width: calc(410 / 358 * 100cqw);
    }

    h1 {
      padding-top: 1.5cqw;
      font-size: 15cqw;
    }

    .lead {
      max-width: none;
      margin-top: 2.5cqw;
      padding-bottom: calc(292 / 358 * 100cqw);
      font-size: 0.97rem;
      line-height: 1.6;
    }
  }
</style>
