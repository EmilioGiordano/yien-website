---
import { HeroApp } from "../app/islands/HeroApp";
import { agentTranscripts, toRows } from "../data/transcripts";
import { heroWorkspaces } from "../data/workspaces";

const ROW_WIDTH = 60;
const ROWS = 36;
const ROWS_PER_SECOND = [1.3, 2.1, 0.9, 1.7, 2.6];

const transcripts = agentTranscripts(heroWorkspaces);
const panes = ROWS_PER_SECOND.map((speed, pane) => {
  const text = transcripts.filter((_, index) => index % ROWS_PER_SECOND.length === pane).join("  ");
  const rows = toRows(text.repeat(Math.ceil((ROWS * ROW_WIDTH) / text.length)), ROW_WIDTH);
  return {
    duration: ROWS / speed,
    log: [...rows.slice(0, ROWS), ...rows.slice(0, ROWS)].join("\n"),
  };
});
---

<section class="hero">
  <div class="wrap">
    <div class="title">
      <div class="headline">
        <div class="panes" aria-hidden="true" style={`--rows: ${ROWS}`}>
          {panes.map(({ duration, log }) => (
            <div class="pane">
              <div class="log" style={`--duration: ${duration}s`} set:text={log} />
            </div>
          ))}
        </div>
        <h1>
          <span class="many">
            Many <span class="word">agents.</span>
          </span>
          <span class="one">
            One <span class="word">thread.</span>
          </span>
        </h1>
      </div>
      <p class="lead">
        YIEN is a workspace for your coding agents. You only hear from them when one needs you.
      </p>
    </div>
    <div class="window" data-thread-start>
      <HeroApp client:load />
    </div>
    <noscript>
      <p class="note">
        This window needs JavaScript. It shows agents working in tabs and terminals.
      </p>
    </noscript>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(4px, 1vw, 16px) 0 clamp(56px, 8vw, 112px);
    overflow-x: clip;
    background: var(--sumi);
    color: var(--on-sumi);
  }

  .title {
    --size: 15.9cqw;
    --many-lines: 1;
    position: relative;
    display: flex;
    flex-direction: column;
    container-type: inline-size;
  }

  .headline {
    position: relative;
    isolation: isolate;
  }

  h1 {
    position: relative;
  }

  .many,
  .one {
    position: relative;
    display: block;
    font-size: var(--size);
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
  }

  .word {
    display: inline-block;
  }

  /* The letters are cut through to the terminals behind them: `darken` keeps the
     panes where the text is white and sumi everywhere else. */
  .many {
    margin-bottom: -0.19em;
    padding-bottom: 0.2em;
    background: var(--sumi);
    color: #fff;
    mix-blend-mode: darken;
  }

  .panes {
    position: absolute;
    inset: 0 0 auto;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 2px;
    height: calc(var(--size) * (var(--many-lines) + 0.2));
    background: var(--sumi);
    color: var(--paper);
    font: 500 max(5.5px, 0.7cqw) / 1.15 var(--mono);
  }

  .pane {
    overflow: hidden;
    background: #4a4842;
  }

  .log {
    white-space: pre;
    animation: scroll var(--duration) steps(var(--rows)) infinite;
  }

  @keyframes scroll {
    to {
      transform: translateY(calc(var(--rows) * -1.15em));
    }
  }

  .one {
    color: var(--paper);
  }

  .lead {
    position: absolute;
    top: 3cqw;
    left: 16.3cqw;
    color: var(--on-sumi-muted);
    font-size: 0.95rem;
    line-height: 1.5;
    white-space: nowrap;
  }

  /* The thread comes in from the edge of the page under the title and drops behind the window. */
  h1::after {
    content: "";
    position: absolute;
    top: calc(100% - var(--size) * 0.05);
    right: calc(50% - 50vw);
    left: 0;
    height: 24px;
    border-top: 2px solid var(--thread);
    border-left: 2px solid var(--thread);
    animation: draw 1.4s cubic-bezier(0.6, 0, 0.2, 1) both;
  }

  @keyframes draw {
    from {
      clip-path: inset(0 0 0 100%);
    }
    to {
      clip-path: inset(0);
    }
  }

  .window {
    position: relative;
  }

  .note {
    padding: 24px 0;
    color: var(--on-sumi-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .log,
    h1::after {
      animation: none;
    }
  }

  @media (max-width: 1040px) {
    .lead {
      position: static;
      order: -1;
      margin: 4px 0 20px;
      white-space: normal;
    }
  }

  @media (max-width: 760px) {
    .title {
      --size: 27cqw;
      --many-lines: 2;
    }

    .many,
    .one {
      white-space: normal;
    }

    .word {
      display: block;
    }

    .window {
      margin-top: 4px;
    }
  }
</style>
