---
import { HeroApp } from "../app/islands/HeroApp";
---

<section class="hero">
  <div class="wrap">
    <div class="copy">
      <h1>
        Many agents.
        <br />
        One thread.
      </h1>
      <p class="lead">Your coding agents, side by side in one window.</p>
    </div>
    <img class="plate" src="/hero-plate.svg" alt="" width="1000" height="1000" />
    <div class="stage" data-thread-start>
      <HeroApp client:load />
    </div>
    <noscript>
      <p class="note">
        This window needs JavaScript. It shows agents working in tabs and terminals.
      </p>
    </noscript>
  </div>
</section>

<style>
  .hero {
    --paper-from: clamp(320px, 46svh, 460px);
    position: relative;
    overflow: clip;
    background: linear-gradient(var(--shu) calc(100% - var(--paper-from)), transparent 0);
  }

  .plate {
    position: absolute;
    top: clamp(-96px, -5vw, -40px);
    right: max(-40px, calc((100% - var(--wrap)) / 2 - 40px));
    width: clamp(400px, 40vw, 620px);
    height: auto;
  }

  .copy {
    position: relative;
    padding: clamp(32px, 5vw, 72px) 0 clamp(40px, 5vw, 72px);
    color: var(--paper);
  }

  h1 {
    font-size: clamp(3.1rem, 7.4vw, 6.6rem);
    line-height: 1;
  }

  .lead {
    margin-top: 24px;
    font-size: 1.2rem;
    line-height: 1.5;
  }

  .stage {
    position: relative;
  }

  .note {
    padding: 24px 0;
    color: var(--pencil);
  }

  @media (max-width: 760px) {
    .copy {
      padding-bottom: 8px;
    }

    .plate {
      position: static;
      display: block;
      width: min(100%, 420px);
      margin: 0 auto -48px;
    }
  }
</style>
