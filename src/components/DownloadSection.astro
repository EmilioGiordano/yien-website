---
import { DownloadPanel } from "../app/islands/DownloadPanel";
---

<section class="closing" id="download" aria-labelledby="download-title">
  <span class="kanji" lang="ja" aria-hidden="true">
    縁
  </span>
  <div class="wrap indent">
    <h2 id="download-title">Put your agents to work.</h2>
    <p>
      YIEN is free for personal use and runs on your own machine. Your code, your agents and your
      accounts stay where they are.
    </p>
    <DownloadPanel client:visible />
  </div>
</section>

<style>
  .closing {
    position: relative;
    padding: clamp(88px, 12vw, 168px) 0 clamp(72px, 9vw, 128px);
    overflow: hidden;
    background: var(--sumi);
    color: var(--on-sumi);
  }

  .kanji {
    position: absolute;
    top: -0.14em;
    right: -0.04em;
    color: color-mix(in srgb, var(--on-sumi) 6%, var(--sumi));
    font: 800 min(64vw, 860px) / 1 var(--mincho);
    pointer-events: none;
    user-select: none;
  }

  .wrap {
    position: relative;
  }

  h2 {
    max-width: 12ch;
    font-size: clamp(3rem, 8.4vw, 7.6rem);
    line-height: 1;
  }

  p {
    max-width: 52ch;
    margin-top: 28px;
    color: var(--on-sumi-muted);
  }
</style>
